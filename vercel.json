{
  "framework": null,
  "functions": {
    "api/site-monitor.js": {
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/adsense.js",
      "destination": "/api/player-photo?__am4_adsense_loader=1"
    },
    {
      "source": "/teams/:teamId",
      "destination": "/api/fixtures?teamPage=1&teamId=:teamId"
    },
    {
      "source": "/players/:playerId",
      "destination": "/api/player-photo?playerPage=1&playerId=:playerId"
    },
    {
      "source": "/article.html",
      "destination": "/api/articles?articlePage=1"
    },
    {
      "source": "/match.html",
      "destination": "/api/fixtures?matchPage=1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/articles?articleSitemap=1"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/company",
      "destination": "/company.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/read-later",
      "destination": "/read-later.html"
    },
    {
      "source": "/column",
      "destination": "/column.html"
    },
    {
      "source": "/column/20-seasons",
      "destination": "/column-20-seasons.html"
    }
  ],
  "crons": [
    {
      "path": "/api/articles?trendingRefresh=1",
      "schedule": "45 8 * * *"
    },
    {
      "path": "/api/site-monitor?cron=1",
      "schedule": "30 0,6,12,18 * * *"
    },
    {
      "path": "/api/site-monitor?continuation=1",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/site-monitor?editorialContinuation=1",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/site-monitor?watchdog=1",
      "schedule": "10 0,6,12,18 * * *"
    }
  ]
}
